# Copiar para Backend/.env (só para correr a API fora do Docker, na porta 8001).
# O Backend/.env está no .gitignore e nunca deve ir para o repositório.

# Base de dados publicada pelo compose.debug.yaml
DATABASE_HOST=127.0.0.1
DATABASE_PORT=15432
DATABASE_NAME=trustvote
DATABASE_USER=trustvote
# O mesmo valor de TRUSTVOTE_DB_PASSWORD do Infraestrutura/.env
DATABASE_PASSWORD=mudar_password_trustvote
# Opcional: réplica para as leituras públicas (ex.: 127.0.0.1:15433)
DATABASE_READ_HOST=

# Obrigatório (16+ caracteres). O mesmo valor de JWT_SECRET do Infraestrutura/.env
JWT_SECRET=mudar_jwt_por_uma_string_longa
JWT_MINUTOS_VALIDADE=60
# Opcional: segredo do selo dos votos (vazio = derivado do JWT_SECRET)
VOTO_HMAC_SECRET=

# Opcional: Redis (logout imediato e limite de tentativas de login). Sem REDIS_HOST fica desligado.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
LOGIN_TENTATIVAS=5
LOGIN_JANELA_SEGUNDOS=900

# Regras da aplicação
REGISTO_RESTRITO=false
TAREFAS_INTERVALO=30
# imediato = apura no próprio pedido (sem worker); worker = pede o apuramento ao worker (Docker)
APURAMENTO=imediato
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:8081,http://localhost:8081,http://127.0.0.1:8082,http://localhost:8082
