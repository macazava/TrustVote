# Finais de linha: o git converte para CRLF no Windows (core.autocrlf), mas os ficheiros
# que correm dentro dos contentores Linux têm de ficar em LF em qualquer PC.
* text=auto

*.sh        text eol=lf
*.sql       text eol=lf
*.py        text eol=lf
*.conf      text eol=lf
*.template  text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
.env*       text eol=lf
Dockerfile  text eol=lf

# Correm no Windows
*.ps1       text eol=crlf
*.cmd       text eol=crlf

*.png       binary
*.jpg       binary
