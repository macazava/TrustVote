# Credenciais usadas pelos scripts de inicialização do PostgreSQL desta pasta
# (00-trustvote-user.sql e trustvote.sql). O .env está no .gitignore.
# Copiar para .env e substituir todos os valores "mudar_*".

# Superutilizador do PostgreSQL (criado pela imagem postgres:16)
POSTGRES_PASSWORD=mudar_password_postgres

# Utilizador da aplicação (dono da BD/schema trustvote) — lido por 00-trustvote-user.sql
TRUSTVOTE_DB_PASSWORD=mudar_password_trustvote

# Redis (cache / sessões do backend)
REDIS_PASSWORD=mudar_password_redis
