# Copiar para .env (cp .env.example .env) e substituir TODOS os valores "mudar_*".
# O .env está no .gitignore e nunca deve ir para o repositório.

# --- PostgreSQL ---
# Superutilizador (só para administração / inicialização)
POSTGRES_PASSWORD=mudar_password_postgres
# Utilizador da aplicação (dono das tabelas trustvote) — usado pelo backend
TRUSTVOTE_DB_PASSWORD=mudar_password_trustvote
# Utilizador de replicação primário -> réplica
REPLICATION_PASSWORD=mudar_password_replicacao

# --- Redis ---
REDIS_PASSWORD=mudar_password_redis

# --- Nginx (único serviço publicado no anfitrião) ---
# 127.0.0.1 = só este PC. Usar 0.0.0.0 apenas para demonstrar a partir de outro dispositivo na rede.
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_HTTP_PORT=8080

# --- Failover manual da BD (ver README > Promoção da réplica) ---
# Onde as aplicações escrevem / leem. Com os dois nós listados, o backend escolhe sozinho o que
# aceita escritas (também depois de promover a réplica). Em funcionamento normal não alterar.
DB_WRITE_HOST=db-primary,db-replica
DB_READ_HOST=db-replica,db-primary
# Papel de cada nó e de quem clona quando o seu volume está vazio.
DB_PRIMARY_NODE_ROLE=primary
DB_PRIMARY_UPSTREAM=db-replica
DB_REPLICA_NODE_ROLE=replica
DB_REPLICA_UPSTREAM=db-primary
