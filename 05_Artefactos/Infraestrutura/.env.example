# Copiar para .env (cp .env.example .env) e substituir TODOS os valores "mudar_*".
# O .env está no .gitignore e nunca deve ir para o repositório.

# --- PostgreSQL ---
# Superutilizador (só para administração / inicialização)
POSTGRES_PASSWORD=mudar_password_postgres
# Utilizador da aplicação (dono das tabelas trustvote) — usado pelo backend
TRUSTVOTE_DB_PASSWORD=mudar_password_trustvote
# Utilizador de replicação primário -> réplica
REPLICATION_PASSWORD=mudar_password_replicacao

# --- Redis ---
REDIS_PASSWORD=mudar_password_redis

# --- Autenticação ---
# Segredo que assina os tokens: uma string longa e aleatória (16+ caracteres), igual nas duas instâncias
JWT_SECRET=mudar_jwt_por_uma_string_longa
# Segredo do selo de integridade dos votos. Opcional (vazio = derivado do JWT_SECRET).
# Mudá-lo depois de haver votos faz com que esses votos deixem de contar.
VOTO_HMAC_SECRET=

# --- Regras da aplicação ---
# true = só os números da lista oficial (área da equipa > Eleitores) podem criar conta
REGISTO_RESTRITO=false
# Segundos entre ciclos do worker (iniciar eleições, abrir/fechar voltas, apurar o que ficou por apurar)
TAREFAS_INTERVALO=30

# --- Nginx (únicos serviços publicados no anfitrião) ---
# 127.0.0.1 = só este PC. Usar 0.0.0.0 apenas para demonstrar a partir de outro dispositivo na rede.
NGINX_BIND_ADDRESS=127.0.0.1
# Site: sempre pela entrada (8080), que passa sozinha para o servidor que estiver de pé.
# 8081 e 8082 dão acesso direto ao Nginx 1 e ao Nginx 2. Mudar só se a porta estiver ocupada.
ENTRADA_PORT=8080
NGINX1_PORT=8081
NGINX2_PORT=8082

# --- Cópias automáticas da BD (serviço "backup", ficheiros em Infraestrutura/backups) ---
# Uma cópia a cada N horas, confirmada por restauro; ficam só as últimas BACKUP_MANTER.
BACKUP_INTERVALO_HORAS=6
BACKUP_MANTER=28
