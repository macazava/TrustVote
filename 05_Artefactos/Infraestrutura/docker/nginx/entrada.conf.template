# TrustVote — balanceador de entrada (árbitro): o único endereço que o utilizador usa.
#
# http://127.0.0.1:8080 -> nginx1 (Servidor 1) ou nginx2 (Servidor 2). Se um servidor
# inteiro cair, os pedidos passam sozinhos para o outro: o site continua no mesmo
# endereço, mesmo ao recarregar a página. Fica fora dos dois servidores, como o monitor.

log_format entrada '$remote_addr [$time_local] "$request" $status '
                   'servidor=$upstream_addr estado=$upstream_status rt=$request_time';

upstream servidores {
    # IPs fixos (ver compose.yaml): sem DNS, a entrada nunca fica sem servidores por ter
    # arrancado antes deles, e um servidor parado é detetado logo na ligação.
    # Um servidor que não aceita ligações fica de lado 5 s; depois volta a ser experimentado.
    server 172.30.0.31:80 max_fails=1 fail_timeout=5s;   # nginx1 (Servidor 1)
    server 172.30.0.32:80 max_fails=1 fail_timeout=5s;   # nginx2 (Servidor 2)

    keepalive 16;
}

server {
    listen 80;
    server_name _;
    absolute_redirect off;

    access_log /var/log/nginx/access.log entrada;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        proxy_pass http://servidores;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Um servidor parado não responde: desiste depressa e tenta o outro.
        proxy_connect_timeout 1s;
        proxy_read_timeout    6s;

        # Só muda de servidor quando o nginx dele não responde (servidor em baixo). Um 502/504
        # vem de dentro de um servidor que está de pé, e o nginx dele já trata disso; contá-lo
        # aqui como falha podia pôr os dois servidores de lado ao mesmo tempo. Um POST (ex.:
        # um voto) que já chegou a um servidor nunca é repetido no outro.
        proxy_next_upstream error timeout;
        proxy_next_upstream_tries 2;

        # Mostra que servidor respondeu (útil na demonstração)
        add_header X-Servidor $upstream_addr always;
    }
}
