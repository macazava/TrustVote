# TrustVote — site e reverse proxy / balanceador de carga (modelo comum aos dois nginx)
#
# A imagem do nginx gera /etc/nginx/conf.d/default.conf a partir deste ficheiro,
# substituindo as variáveis ${...} do ambiente (ver compose.yaml):
#   NGINX_NOME              nome devolvido no cabeçalho X-Nginx
#   UPSTREAM_PRINCIPAL      instância preferida deste nginx
#   UPSTREAM_SECUNDARIO     a outra instância
#   UPSTREAM_SECUNDARIO_MODO  vazio = round-robin entre as duas; "backup" = só se a principal falhar

# Regista para cada pedido a instância que respondeu e o estado de cada tentativa.
log_format trustvote '$remote_addr [$time_local] "$request" $status '
                     'upstream=$upstream_addr upstream_status=$upstream_status '
                     'rt=$request_time urt=$upstream_response_time';

upstream trustvote_app {
    # IPs fixos das duas APIs (ver compose.yaml): sem DNS, nunca se tenta o IP antigo de
    # uma API que acabou de cair. Uma falha retira-a durante 5 s; depois volta a ser
    # experimentada.
    server ${UPSTREAM_PRINCIPAL}:8080 max_fails=1 fail_timeout=5s;
    server ${UPSTREAM_SECUNDARIO}:8080 max_fails=1 fail_timeout=5s ${UPSTREAM_SECUNDARIO_MODO};

    keepalive 16;
}

server {
    listen 80;
    server_name _;
    # Redirecionamentos relativos: mantêm a porta publicada (8081/8082) em vez da interna (80)
    absolute_redirect off;

    access_log /var/log/nginx/access.log trustvote;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Site (pasta Frontend, montada só de leitura): http://127.0.0.1:8080/
    location = / {
        return 302 /pages/inicio.html;
    }
    location / {
        root /usr/share/nginx/html;
        try_files $uri =404;
    }
    # Ficheiros de desenvolvimento da pasta Frontend: não fazem parte do site
    location ~ ^/node_modules/|^/(package(-lock)?\.json|README\.md)$ {
        return 404;
    }

    # API: /api/eleicoes chega às instâncias como /eleicoes
    location /api/ {
        proxy_pass http://trustvote_app/;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 1s;
        # Os pedidos demoram milissegundos: uma instância congelada é detetada em 4 s.
        proxy_read_timeout    4s;

        # Se uma instância falhar, tenta a outra. O nginx NÃO repete pedidos não idempotentes
        # (POST de voto, etc.) que já tenham chegado à instância, evitando votos duplicados.
        # O 503 da API não entra aqui: significa BD indisponível, não uma instância em falha.
        proxy_next_upstream error timeout http_502;
        proxy_next_upstream_tries 2;

        # Os dados mudam a cada pedido: o browser nunca guarda respostas da API em cache
        add_header Cache-Control "no-store" always;

        # Permite ver que nginx e que instância responderam (balanceamento)
        add_header X-Nginx "${NGINX_NOME}" always;
        add_header X-Upstream-Server $upstream_addr always;
    }
}
