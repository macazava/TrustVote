# PLACEHOLDER — substituir pelo backend real (ver README > Integração com o backend).
# Não contém lógica de negócio: apenas responde /health e identifica a instância,
# para se poder testar o balanceamento e a falha de uma instância.
# ${APP_INSTANCE} é substituído pela imagem nginx (envsubst) no arranque.
server {
    listen 8080;

    location = /health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok","instance":"${APP_INSTANCE}"}\n';
    }

    location / {
        default_type application/json;
        add_header X-Instance "${APP_INSTANCE}" always;
        return 200 '{"instance":"${APP_INSTANCE}","placeholder":true,"message":"backend ainda nao integrado"}\n';
    }
}
