{
  "name": "trustvote-frontend",
  "private": true,
  "description": "Frontend do TrustVote: compilação do CSS do Tailwind (o site em si não precisa de Node).",
  "scripts": {
    "css": "tailwindcss -c js/tailwind.config.js -i css/tailwind/entrada.css -o css/tailwind.css --minify",
    "css:watch": "tailwindcss -c js/tailwind.config.js -i css/tailwind/entrada.css -o css/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.16"
  },
  "engines": {
    "node": ">=22"
  }
}
